#
## Copy to .env and add only the credentials you intend to use.
## Never commit real credentials.
AGENTGATEWAY_API_KEY=agw_sk_CHANGE_ME
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=

## Which backend the lab starters use when you do not name a provider
## explicitly. Leave blank to auto-detect from the credentials you set above.
##
##   agentgateway/ollama   local Ollama behind the local gateway
##   agentgateway/openai   OpenAI behind the local gateway
##   agentgateway/gemini   Gemini behind the local gateway
##   ollama                Ollama directly (OLLAMA_BASE_URL)
##   gemini                Gemini API (GOOGLE_API_KEY / GEMINI_API_KEY)
##   openai                OpenAI API (OPENAI_API_KEY)
##
## Auto-detect order is agentgateway -> ollama -> gemini -> openai.
#DEFAULT_MODEL_PROVIDER=agentgateway/gemini
DEFAULT_MODEL_PROVIDER=

#model name: agentgateway/gemini-3.8-flash  gemini-3.8-flash
MODEL=

## Per-provider model override. Used when DEFAULT_MODEL_PROVIDER names that
## provider and MODEL is blank.
AGENTGATEWAY_MODEL=
OLLAMA_MODEL=
GEMINI_MODEL=
OPENAI_MODEL=

## Optional native-protocol AI gateway endpoints. Leave blank to use each
## provider's official API endpoint. OpenAI requires Responses API support.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GEMINI_BASE_URL=

## Local gateway and Ollama endpoints. Setting either one turns that provider
## on for auto-detection, so leave blank unless you run them.
AGENTGATEWAY_BASE_URL=
OLLAMA_BASE_URL=

## --- Telegram bot (labs from week 2 on) --------------------------------------

## The bot's API token, issued by @BotFather (https://t.me/BotFather).
## This is a credential, not a URL: anyone holding it controls the bot and can
## read every message it receives. NEVER commit a real token.
TELEGRAM_BOT_API=

## Comma-separated numeric Telegram user IDs allowed to talk to the bot,
## e.g. 123456789,987654321. This is the access control for the lab agent.
##
## It is an ALLOWLIST, so an empty value means the opposite of "nobody": a lab
## that does not check for it answers any stranger who finds the bot. Set it
## before the bot is reachable from the internet.
##
## Find your own id by messaging @userinfobot — a username is not an id, and
## usernames can be changed by their owner.
TELEGRAM_ALLOW_USER_IDS=

## The name the agent uses for you in prompts and replies. Cosmetic only: it
## personalises output and never grants access — that is TELEGRAM_ALLOW_USER_IDS.
USER_NAME=

## --- monobank (Day 2 labs) ---------------------------------------------------

## Personal API token from https://api.monobank.ua/ (the "Token" in the personal
## cabinet), consumed by the mono-go-mcp server as MONO_TOKEN. Enables the
## /personal/* tools: client-info, statement, set-webhook.
##
## The public tools (mono_currency_rates, mono_bank_sync) need NO token, so the
## Day 2 core path runs offline or token-free. Leave this blank until you work on
## the MCP boundary, and never commit a real token.
##
## The name is MONO_TOKEN because that is what mono-go-mcp reads
## (cmd/mono-go-mcp/main.go): an env var no process looks up is a silent
## no-op, and the failure is invisible — the public tools still work.
MONO_TOKEN=

## Optional: override the monobank API base URL. Leave blank to use
## https://api.monobank.ua. Set it only to point at a stub in tests.
MONO_BASE_URL=
